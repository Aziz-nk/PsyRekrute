# ==============================================================================
# PSYREKRUTE - TEMPLATE DES VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# ==============================================================================
# ATTENTION DE SÉCURITÉ :
# - Ce fichier sert de modèle documentaire. Ne JAMAIS y inscrire de vrais secrets.
# - En production, copier ce fichier vers un emplacement sécurisé (ex: .env.production)
#   et restreindre strictement les permissions : chmod 600 .env.production
# - Tous les mots de passe et clés secrètes doivent comporter au moins 32 caractères
#   aléatoires (256 bits d'entropie minimum).
#   Génération recommandée sous Linux : openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT GÉNÉRAL ET DOMAINE
# ------------------------------------------------------------------------------
NODE_ENV=production
# URL publique principale servie en HTTPS (SANS slash final)
# Exemple : https://psyrekrute.ma
PRODUCTION_URL=https://votre-domaine.ma

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=psyrekrute_prod_user
# Mot de passe complexe généré aléatoirement (ex: openssl rand -base64 24)
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD_256_BITS
POSTGRES_DB=psyrekrute_prod_db
# Port interne du conteneur (non exposé directement sur Internet)
POSTGRES_PORT=5432

# URL de connexion complète utilisée par Prisma ORM
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 3. STOCKAGE S3 / MINIO (CV Candidats & Documents ICE)
# ------------------------------------------------------------------------------
# Obligatoirement 's3' en production (l'adaptateur 'local' est strictement interdit par StorageModule)
STORAGE_DRIVER=s3

# Endpoint S3 (MinIO interne : http://minio:9000 ou fournisseur cloud S3 ex: https://s3.eu-west-3.amazonaws.com)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

# Identifiants du service de stockage d'objets
# En cas d'utilisation de MinIO conteneurisé, ces variables alimentent le root admin
S3_ACCESS_KEY=CHANGE_ME_MINIO_OR_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_GENERATE_S3_SECRET_KEY_MIN_32_CHARS

# Nom du bucket privé (ne doit JAMAIS être rendu public)
MINIO_BUCKET_DOCUMENTS=psyrekrute-documents-prod

# ------------------------------------------------------------------------------
# 4. SÉCURITÉ AUTHENTIFICATION JWT (RBAC & SESSIONS)
# ------------------------------------------------------------------------------
# Clé secrète de signature des tokens d'accès JWT (OBLIGATOIRE : minimum 256 bits / 32 octets aléatoires)
# Commande de génération : openssl rand -base64 32
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_MINIMUM_256_BITS_RANDOM

# Durée de validité du token d'accès court (conforme DCTF : 15m)
JWT_ACCESS_EXPIRATION=15m

# Clé secrète de signature des tokens de rafraîchissement JWT (OBLIGATOIRE : minimum 256 bits)
# Commande de génération : openssl rand -base64 32
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MINIMUM_256_BITS_RANDOM

# Durée de validité du token de rafraîchissement en cookie HttpOnly (conforme DCTF : 7d)
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 5. CONFIGURATION DU REVERSE PROXY ET RÉSEAU
# ------------------------------------------------------------------------------
# Spécification des proxys de confiance pour l'extraction sécurisée de l'adresse IP cliente (req.ip)
# Dans la pile Docker Compose standard : loopback,linklocal,uniquelocal
TRUSTED_PROXIES=loopback,linklocal,uniquelocal
# Nombre de sauts proxy autorisés (1 si Nginx est l'unique reverse proxy devant l'API)
TRUSTED_PROXY_HOPS=1

# ------------------------------------------------------------------------------
# 6. CONFIGURATION FRONTEND NEXT.JS
# ------------------------------------------------------------------------------
# Port d'écoute interne du serveur Next.js standalone
PORT=3000
# Préfixe API utilisé par le client (derrière Nginx, le routage /api/v1 est relatif)
NEXT_PUBLIC_API_URL=/api/v1
# Langue par défaut de l'interface (fr, ar, en)
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# ------------------------------------------------------------------------------
# 7. SCRIPTS DE SAUVEGARDE ET RÉTENTION
# ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/psyrekrute
RETENTION_DAYS=14
